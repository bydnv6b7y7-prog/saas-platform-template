# 复制为 .env（apps/web/.env）
VITE_SERVER_URL=http://localhost:3000
VITE_BRAND_NAME=Northwind
VITE_WEB_URL=http://localhost:3001
# 本地和预发布默认禁止收录；生产由 CI 注入评审值，当前在公开收录审批前保持 false。
VITE_ENABLE_INDEXING=false

# PostHog browser analytics (project token is public but remains environment-scoped).
# Leave unset in local development unless events should enter the selected PostHog project.
# VITE_POSTHOG_PROJECT_TOKEN=phc_xxx
# Browser events use a first-party reverse proxy (default in packages/env/src/posthog-hosts.ts);
# server events remain direct.
# VITE_POSTHOG_HOST=
# Server-side privacy policy: opt_in (safe local default), opt_out, or geo.
# geo reads trusted Cloudflare CF-IPCountry and fails closed when it is absent.
ANALYTICS_PRIVACY_MODE=opt_in
# ANALYTICS_OPT_IN_COUNTRIES overrides the complete default list; see docs/analytics.md.

# 仅供 TanStack Start 服务端访问；浏览器不会读取。未设置时回退到 VITE_SERVER_URL。
SERVER_URL=http://localhost:3000
