# 复制为 apps/server/.env。配置归属、默认值与高级参数：docs/configuration.md
# 日常运行设置（如助手额度）在 Admin → Settings 调整，不需要环境变量。

# —— 基础连接（必填）——
DATABASE_URL=postgresql://postgres:password@localhost:5432/northwind
BETTER_AUTH_SECRET=replace-with-at-least-32-chars-random-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# —— 邮件验证 ——
# 本地开发：验证码等邮件投递到 Mailpit（bun run db:start 一并启动），在 http://localhost:8025 查看。
EMAIL_DEV_MAILPIT_URL=http://localhost:8025
# 生产：Cloudflare Email Sending（整组配置；缺失时无法发送验证码）
# Cloudflare 发信域名与 Token 权限：docs/email-verification.md
# CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
# CLOUDFLARE_EMAIL_API_TOKEN=your-account-scoped-email-sending-token
# EMAIL_FROM="Northwind <noreply@northwind.dev>"

# —— 登录用户 AI 助手（选择 provider，只填写对应密钥）——
# 其他 provider、自定义模型与上下文预算：docs/ai-assistant.md
# COPILOT_MODEL_PROVIDER=openai-compatible
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://your-openai-compatible-host.example/v1
# LLM_MODEL=custom-chat-model
# 自定义 LLM_BASE_URL 必须同时填写 LLM_MODEL 或 COPILOT_MODEL。
COPILOTKIT_TELEMETRY_DISABLED=true

# —— 管理员（先注册，再运行 bun run admin:lookup user@example.com）——
# 填 Better Auth user.id，逗号分隔；正式权限也支持数据库 role=admin。
ADMIN_USER_IDS=

# —— Stripe（本地整组留空可停用）——
# Price、Webhook 与权限说明：docs/subscriptions.md
# STRIPE_SECRET_KEY=rk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_YEARLY=price_xxx

# —— StoreKit 2（默认开启，启动前须完整配置）——
# IAP 专用密钥，不复用 Apple 登录密钥；验收步骤：docs/app-store-subscriptions.md
# 应用、Bundle ID、订阅组与商品由 packages/env/src/apple-application.ts 统一维护。
# Admin → Settings → App Store subscriptions 查看接入状态和通知处理。
# APP_STORE_ISSUER_ID=
# APP_STORE_KEY_ID=
# APP_STORE_PRIVATE_KEY_BASE64=
# 显式选择测试环境；不设置时 schema 默认 Production。
# APP_STORE_ENVIRONMENTS=Sandbox
# 有 App Store Connect 凭据后改为 true（默认 true 时缺凭据会拒绝启动）
APP_STORE_ENABLED=false

# —— OAuth（按 provider 整组填写，留空则隐藏）——
# 回调、原生 audience 和 Apple HTTPS 要求：docs/native-ios-auth.md
# GOOGLE_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=com.example.web-service-id
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_BASE64=

# —— 可选：服务端分析 ——
# POSTHOG_PROJECT_TOKEN=phc_xxx
# 产品自己的变量见 packages/product/src/env.ts。
