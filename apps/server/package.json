{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --watch run src/index.ts",
    "admin:lookup": "bun run src/admin-lookup-cli.ts",
    "admin:app-store": "bun run src/admin-app-store-cli.ts",
    "mastra:migrate": "bun run src/mastra/migrate.ts",
    "test": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/appstore_test BETTER_AUTH_SECRET=test-only-secret-test-only-secret-123 BETTER_AUTH_URL=http://127.0.0.1:3000 CORS_ORIGIN=http://127.0.0.1:3001 COPILOT_MODEL_PROVIDER=openai-compatible COPILOTKIT_TELEMETRY_DISABLED=true APP_STORE_ENABLED=false SKIP_ENV_VALIDATION= bun test src/logging.test.ts src/mastra src/billing src/app-client --path-ignore-patterns='dist/**'",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@northwind/api": "workspace:*",
    "@northwind/auth": "workspace:*",
    "@northwind/better-auth-app-store": "workspace:*",
    "@northwind/billing": "workspace:*",
    "@northwind/db": "workspace:*",
    "@northwind/env": "workspace:*",
    "@northwind/product": "workspace:*",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/mastra": "^2.0.2",
    "@ai-sdk/openai": "^4.0.106",
    "@copilotkit/runtime": "^1.83.0",
    "@hono/trpc-server": "^0.4.2",
    "@mastra/client-js": "^1.58.0",
    "@mastra/core": "^1.81.0",
    "@mastra/memory": "^1.40.0",
    "@mastra/observability": "^1.23.0",
    "@mastra/pg": "^1.34.0",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "rxjs": "7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@northwind/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.4",
    "typescript": "catalog:"
  }
}
