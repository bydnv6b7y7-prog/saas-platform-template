# 部署变量清单（复制为 .env.dokploy.local 填入真实值；.env*.local 已被 .gitignore 忽略）
#
# 上线三步：
#   1. bun run deploy:provision        在 Dokploy 建项目、PostgreSQL、migration/server/web（+ 产品 worker），
#                                      并把 applicationId、数据库密码、生成的 BETTER_AUTH_SECRET 回写本文件
#   2. bun run deploy:github --apply   把下列标注 Secret / Variable 的值写入 GitHub Actions
#   3. bun run deploy:production       推送 main，.github/workflows/deploy.yml 构建镜像并按序发布
# 发布前可运行 bun run doctor --deploy 逐项检查。

# —— 发布策略 ——
DEPLOY_STAGE=production                              # Variable：production 只接受 Live Stripe 密钥；staging 只接受 Test 密钥
REQUIRED_INTEGRATIONS=email                 # Variable：列出的集成缺失时拒绝发布；未列出的集成留空即关闭

# —— Dokploy ——
DOKPLOY_URL=https://dokploy.example.com              # Secret（Dokploy 面板地址）
DOKPLOY_API_KEY=replace-me                           # Secret（Dokploy Settings → API/CLI 创建）
DOKPLOY_DB_PASSWORD=                                 # 首次供给留空会自动生成并回写；既有数据库必须填写
# 以下由 deploy:provision 回写，无需手填：
# DOKPLOY_MIGRATION_APPLICATION_ID / DOKPLOY_SERVER_APPLICATION_ID / DOKPLOY_WEB_APPLICATION_ID
# DOKPLOY_WORKER_APPLICATION_ID（仅当产品在 packages/product/src/deployment.ts 声明了 worker）

# —— GHCR 镜像 ——
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAMESPACE=your-github-user              # Variable IMAGE_NAMESPACE（小写；镜像推到 ghcr.io/<namespace>/）
DOCKER_REGISTRY_USERNAME=your-github-user            # Secret
DOCKER_REGISTRY_PASSWORD=replace-me                  # Secret（GitHub PAT，需 read:packages + write:packages）
# DOCKER_IMAGE_TAG=                                  # 可选；默认当前 HEAD，发布工作流会再按构建 SHA 重新固定

# —— 域名与 Web 构建 ——
VITE_SERVER_URL=https://api.example.com              # Secret（API 域名，DNS 指向 Dokploy 服务器）
VITE_WEB_URL=https://app.example.com                 # Secret（Web 域名，同时用于 canonical、sitemap、CORS）
PRODUCTION_BRAND_NAME=Northwind                        # Variable
PRODUCTION_ENABLE_INDEXING=false                     # Variable：允许搜索引擎收录时改为 true
ANALYTICS_PRIVACY_MODE=geo                           # Web runtime: geo / opt_in / opt_out

# —— PostHog（可选；从 REQUIRED_INTEGRATIONS 去掉 posthog 并留空即关闭分析）——
POSTHOG_PROJECT_TOKEN=                               # Secret（GitHub 与 API 共用同一 project token）
# VITE_POSTHOG_HOST=                                 # Variable；默认 packages/env/src/posthog-hosts.ts（浏览器端反向代理）
# POSTHOG_HOST=https://us.i.posthog.com              # Variable；服务端直连 ingestion，不能与浏览器端相同

# —— 服务端（只注入 API 应用）——
# BETTER_AUTH_SECRET=                                # 留空则首次供给时生成并回写
ADMIN_USER_IDS=                                      # 先注册，再 bun run admin:lookup you@example.com 取 user.id；逗号分隔
COPILOT_MODEL_PROVIDER=deepseek                      # deepseek | openrouter | openai-compatible
# COPILOT_MODEL=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY= / LLM_BASE_URL= / LLM_MODEL=          # openai-compatible 时填写

# —— 邮件（Cloudflare Email Sending；注册验证码依赖它）——
CLOUDFLARE_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_EMAIL_API_TOKEN=replace-with-email-sending-token   # 权限：Email Sending: Edit
EMAIL_FROM="Northwind <noreply@example.com>"

# —— OAuth（按 provider 整组填写；回调 VITE_SERVER_URL/api/auth/callback/{google|github|apple}）——
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GOOGLE_IOS_CLIENT_ID=
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID= / APPLE_TEAM_ID= / APPLE_KEY_ID= / APPLE_PRIVATE_KEY_BASE64=

# —— Stripe（DEPLOY_STAGE 决定 Live / Test；webhook：VITE_SERVER_URL/api/auth/stripe/webhook）——
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# —— App Store 内购（应用身份见 packages/env/src/apple-application.ts）——
APP_STORE_ENABLED=false                              # 有 App Store Connect 凭据后改为 true 并填写下面三项
# APP_STORE_ISSUER_ID= / APP_STORE_KEY_ID= / APP_STORE_PRIVATE_KEY_BASE64=
# APP_STORE_ENVIRONMENTS=Production

# —— 反馈截图（Cloudflare R2；四项同时填写或全部留空）——
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
FEEDBACK_NOTIFY_EMAIL=                               # 可选：每条新反馈发一封通知
